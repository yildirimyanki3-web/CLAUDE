# Copy this file to .env and fill in the API keys you have available.
# Any series whose provider key is missing will be skipped by the data
# manager and reported explicitly in the provenance log rather than
# silently substituted -- see src/dnlssm/data/manager.py.

# TCMB (Central Bank of the Republic of Turkiye) EVDS API
# Obtain at https://evds2.tcmb.gov.tr/index.php?/evds/userLogin
EVDS_API_KEY=

# FRED (Federal Reserve Economic Data)
# Obtain at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# World Bank, IMF (SDMX/IFS) and OECD (SDMX) public APIs do not require keys.
# BIS Statistics Warehouse public API does not require a key.
